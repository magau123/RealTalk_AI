# RealTalk_AI 环境变量模板
#
# 用法：把本文件复制为 .env，填入自己的真实 Key。
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交到 GitHub。
# 请不要把真实 Key 写回本文件（本文件是会被提交的模板）。

# ---- 必填：阿里云百炼（DashScope）API Key ----
# 获取地址：https://bailian.console.aliyun.com/  ->  右上角「API-KEY」
# 官方说明：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 以下均为选填，不填则使用 realtalk/config.py 中的默认值 ----

# 实时语音识别 + 翻译模型（方向一）
# REALTALK_ASR_MODEL=qwen3.5-livetranslate-flash-realtime

# 文本翻译模型（自动模式中中文→外语的补译）
# 官方已说明 qwen-mt-turbo 不再更新，推荐 flash
# REALTALK_MT_MODEL=qwen-mt-flash

# 语音合成模型（方向二）
# REALTALK_TTS_MODEL=cosyvoice-v2

# VAD 断句静音阈值（毫秒，取值 200~6000）。
# 调小则断句更快、交互感更强，但容易把一句话切碎。
# REALTALK_MAX_END_SILENCE=800

# 百炼业务空间专属域名（一般不需要设置，留空即用默认公共域名）
# 若你的账号启用了专属域名，形如：
#   wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# REALTALK_WEBSOCKET_URL=
