      "to": "replyTranslate",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "translationToSpeech",
      "from": "replyTranslate",
      "to": "speechSynthesis",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "speechToSpeaker",
